# Copy to .env — never commit real values
PIPELINE_ID=
PIPELINE_SECRET=
PIPELINE_API_KEY=
HTTP_URL=http://host.docker.internal:8080
RUN_MODE=ALL
# SCAN_ONLY: set DOCKER_TAG if the API does not provide dockerTag.
